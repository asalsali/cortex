# ─── Database ────────────────────────────────────────────────────
# Local development (docker-compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cortex
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/cortex

# Production (Neon) -- use pooled URL for API, unpooled for workers
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/cortex?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/cortex?sslmode=require

# ─── API Server ──────────────────────────────────────────────────
API_PORT=4000
MCP_PORT=4001
NODE_ENV=development

# ─── Auth (Clerk) ────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ─── Billing (Stripe) ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_BUSINESS=price_...

# ─── Slack Integration ──────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ─── AI / Embeddings (Voyage AI) ───────────────────────────────
# Get key at: https://dash.voyageai.com/
# Model: voyage-3-lite (1536 dimensions)
# If not set, vector search is disabled (keyword-only fallback)
VOYAGE_API_KEY=pa-...

# ─── AI / LLM Extraction (Anthropic) ──────────────────────────
# Get key at: https://console.anthropic.com/
# Used for: entity extraction (Haiku), fact consolidation (Sonnet)
# If not set, regex-based extraction fallback is used
ANTHROPIC_API_KEY=sk-ant-...

# ─── Storage (Cloudflare R2) ────────────────────────────────────
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=cortex-uploads
R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com

# ─── Web UI ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
