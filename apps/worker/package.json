{
  "name": "@cortex/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cortex/db": "workspace:*",
    "@cortex/engine": "workspace:*",
    "@cortex/shared": "workspace:*",
    "@cortex/connectors": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "bun-types": "^1.1.0"
  }
}
